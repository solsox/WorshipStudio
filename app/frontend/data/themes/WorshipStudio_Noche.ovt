@OBSThemeMeta {
    name: 'WorshipStudio Noche';
    id: 'com.worshipstudio.Noche';
    extends: 'com.obsproject.Yami';
    author: 'WorshipStudio';
    dark: 'true';
}

/* Calm, low-glare dark theme for the booth during a service: deep warm onyx
 * neutrals, champagne primary buttons, rounded shapes and quiet borders. */
@OBSThemeVars {
    --grey1: #5E5953;
    --grey2: #3E3A36;
    --grey3: #2B2825;
    --grey4: #201E1C;
    --grey5: #181716;
    --grey6: #121110;
    --grey7: #0C0B0B;
    --grey8: #070707;

    --ws_ember1: #A08B66;
    --ws_ember2: #81704F;
    --ws_ember3: #655840;
    --ws_ember4: #4A4131;
    --ws_ember5: #332D23;

    /* Primary buttons: champagne with ink text (selections use the shades above). */
    --ws_button1: #E8D5B0;
    --ws_button2: #DCC59C;
    /* Faint accent light at the top of the window (glass background). */
    --ws_glow: #1E1A15;
    --ws_on_button: #16130E;

    --primary: var(--ws_ember3);
    --primary_light: var(--ws_ember2);
    --primary_lighter: var(--ws_ember1);
    --primary_dark: var(--ws_ember4);
    --primary_darker: var(--ws_ember5);

    --text_muted: #9C958B;

    --border_color: var(--grey4);
    --border_radius: 12px;
    --border_radius_small: 8px;
    --border_radius_large: 18px;

    --input_bg: var(--grey7);
    --input_bg_hover: var(--grey8);
    --input_bg_focus: var(--grey8);
    --input_border: var(--grey4);
    --input_border_hover: var(--grey2);
    --input_border_focus: var(--primary_light);

    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--grey6);
    --button_border: var(--grey4);
    --button_border_hover: var(--grey2);

    --list_item_bg_selected: var(--primary);
    --list_item_bg_hover: var(--grey4);

    --scrollbar_handle: var(--grey3);
    --scrollbar_bg: var(--grey6);
    --scrollbar_border: var(--grey6);
}

/* ---------------------------------------------------------------------- */
/* WorshipStudio look: quiet panel headers, ember primary buttons, defined
 * inputs. Shared by the light and dark themes (and the personalized one). */

QDockWidget {
    font-weight: 600;
    titlebar-close-icon: url(theme:WorshipStudio/panel-close-noche.svg);
    titlebar-normal-icon: url(theme:WorshipStudio/panel-float-noche.svg);
}

QDockWidget::title {
    background: transparent;
    padding: 9px 12px 7px 12px;
    border-bottom: 1px solid var(--grey5);
    border-radius: 0px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    padding: 3px;
    icon-size: 14px;
    min-width: 20px;
    min-height: 20px;
    border-radius: 6px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: var(--grey5);
}

.button-primary {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 var(--ws_button1), stop: 1 var(--ws_button2));
    border: 1px solid var(--ws_button2);
    color: var(--ws_on_button);
    font-weight: 600;
}

.button-primary:hover,
.button-primary:focus {
    background: var(--ws_button1);
    border: 1px solid var(--ws_button1);
    color: var(--ws_on_button);
}

QPushButton:checked {
    border: 1px solid var(--ws_ember1);
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid var(--ws_ember1);
}

/* ---------------------------------------------------------------------- */
/* Glass: the window glows faintly with the accent, panels are translucent
 * cards with a lit edge, and every control is rounded. The layout is the
 * same as OBS; only the surfaces change. Popups stay opaque (a top-level
 * window cannot show what is behind it). */

QMainWindow {
    background: qradialgradient(cx: 0.1, cy: 0, radius: 1.3, fx: 0.1, fy: 0, stop: 0 var(--ws_glow), stop: 0.55 var(--grey7), stop: 1 var(--grey8));
}

QMainWindow::separator {
    background: transparent;
    width: 10px;
    height: 10px;
}

QDockWidget > QWidget {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 18px;
}

QDockWidget::title {
    background: transparent;
    padding: 12px 16px 8px 16px;
    border: none;
}

QDockWidget QAbstractItemView,
QDockWidget QAbstractScrollArea {
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
}

QDockWidget QScrollArea,
QDockWidget QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QDockWidget QListView::item,
QDockWidget QListWidget::item {
    border-radius: 10px;
}

QDockWidget QListView::item:hover,
QDockWidget QListWidget::item:hover {
    background: rgba(255, 255, 255, 0.07);
}

QDockWidget QListView::item:selected,
QDockWidget QListWidget::item:selected {
    background: var(--primary);
}

QPushButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.03);
}

QPushButton:checked {
    background: var(--primary);
    border: 1px solid var(--ws_ember1);
}

QPushButton:disabled {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QComboBox {
    background: rgba(0, 0, 0, 0.30);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}

QComboBox QAbstractItemView,
QDockWidget QComboBox QAbstractItemView {
    background: var(--grey6);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0px;
}

QMainWindow > QTabBar::tab {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: 6px 14px;
    margin: 6px 3px;
}

QMainWindow > QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.11);
}

QMainWindow > QTabBar::tab:selected {
    background: var(--primary);
    border: 1px solid var(--ws_ember1);
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border: none;
}

QScrollBar::handle {
    background: rgba(255, 255, 255, 0.14);
    border: none;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:hover {
    background: rgba(255, 255, 255, 0.24);
}

QMenu {
    border-radius: 12px;
}

/* The primary button keeps its accent over the glass. */
.button-primary {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 var(--ws_button1), stop: 1 var(--ws_button2));
    border: 1px solid var(--ws_button2);
    color: var(--ws_on_button);
}

.button-primary:hover,
.button-primary:focus {
    background: var(--ws_button1);
    border: 1px solid var(--ws_button1);
}
