@OBSThemeMeta {
    name: 'WorshipStudio Dia';
    id: 'com.worshipstudio.Dia';
    extends: 'com.obsproject.Yami.Light';
    author: 'WorshipStudio';
    dark: 'false';
}

/* Light theme for rehearsals and preparing services in bright rooms. */
@OBSThemeVars {
    --ws_ember1: #F57A4A;
    --ws_ember2: #E2582B;
    --ws_ember3: #C2441C;
    --ws_ember4: #943314;
    --ws_ember5: #6E250F;

    --primary: var(--ws_ember3);
    --primary_light: var(--ws_ember2);
    --primary_lighter: var(--ws_ember1);
    --primary_dark: var(--ws_ember4);
    --primary_darker: var(--ws_ember5);

    --border_radius: 8px;
    --border_radius_small: 6px;
    --border_radius_large: 12px;
}
